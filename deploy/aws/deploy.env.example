# Copy to /etc/movie-recs/deploy.env, make it root-owned, mode 600.
# These are PLACEHOLDERS. Never commit real passwords or tokens.
RDS_HOST=movie-recommendation-postgres.XXXXXXXXXXXX.ap-southeast-2.rds.amazonaws.com
RDS_PORT=5432
RDS_ADMIN_USER=movieadmin
RDS_ADMIN_PASSWORD=REPLACE_ME
RDS_APP_USER=app_ro
RDS_APP_PASSWORD=REPLACE_WITH_DIFFERENT_STRONG_PASSWORD
DAGSHUB_USER=REPLACE_ME
DAGSHUB_TOKEN=REPLACE_ME
GEMINI_API_KEY=REPLACE_ME
# For an initial short-lived HTTP test use :80. For a domain with HTTPS use example.org.
# HTTP only for a temporary restricted demo; for a public site use a domain + HTTPS.
SITE_ADDRESS=:80
ALLOWED_HOSTS=["localhost","127.0.0.1","YOUR_EC2_PUBLIC_IP"]
CORS_ORIGINS=["http://YOUR_EC2_PUBLIC_IP"]
# Caddy-to-Uvicorn forwarded headers; adjust after checking actual Docker subnet.
# Caddy's reverse-proxy connection originates from Docker's internal network.
# Set the actual proxy IP/CIDR from `docker network inspect movie-recs_default`.
# Docker may assign a different subnet after network recreation; never use *.
FORWARDED_ALLOW_IPS=127.0.0.1
