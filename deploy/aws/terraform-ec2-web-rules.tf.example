# OPTIONAL: COPY THESE RULES INTO YOUR EXISTING LOCAL terraform/ DIRECTORY.
# Do not create a second aws_security_group.ec2; these use the existing one.
# For a public demo, use 0.0.0.0/0; for a restricted test use YOUR_IP/32.
# Adjust/secure before a production deployment. No SSH, FastAPI or RDS inbound access.
variable "movie_web_allowed_cidr" {
  description = "IPv4 CIDR allowed to reach Caddy HTTP. Restrict during testing."
  type        = string
  default     = "0.0.0.0/0"
}

resource "aws_vpc_security_group_ingress_rule" "movie_http" {
  security_group_id = aws_security_group.ec2.id
  cidr_ipv4         = var.movie_web_allowed_cidr
  ip_protocol       = "tcp"
  from_port         = 80
  to_port           = 80
  description       = "Caddy HTTP temporary test"
}

# For a real hostname with automatic HTTPS, uncomment the next resource
# and configure SITE_ADDRESS=your-domain.example (DNS A -> EC2 public IP).
# resource "aws_vpc_security_group_ingress_rule" "movie_https" {
#   security_group_id = aws_security_group.ec2.id
#   cidr_ipv4         = "0.0.0.0/0"
#   ip_protocol       = "tcp"
#   from_port         = 443
#   to_port           = 443
#   description       = "Caddy HTTPS"
# }
